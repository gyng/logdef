// Deep shade. Biomass-rich and sun-poor — the opposition that makes a
// route a power mix once charge arrives in M1.
#![enable(implicit_some)]
TerrainDef(
    id: "terrain.canopy",
    name: "Dense Canopy",
    yield_pct: 140,
    // Poorest sun of the three bands — richest for biomass, weakest for
    // charge. No band gets to be good at both.
    sun_pct: 35,
    features_per_100_paces: 22,
    feature_kinds: ["tree", "tree", "fern", "vine"],
    // Nothing of the old world left standing under here — no
    // `ruin_kinds`, so nothing the salvage rig can reach.
)

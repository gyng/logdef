// The coast approach's own band: bright, open, and nearly barren.
//
// Region 3's answer to the drowned street. The canopy has thinned to
// nothing, the ground is pale and crusted, and there is almost nothing
// growing on it — the most sun and the least biomass of any band in the
// pack, which is what makes the last region the mirror of the first
// (`SYSTEMS.md` §5.5).
//
// **This is the band the garden is for.** A tower that arrived running
// on bamboo finds a stretch where bamboo barely exists and light is
// free, and either it built something that turns light into food or it
// walks the coast hungry. That is the arc M5 exists to give a run:
// habits formed in the jungle stop working, and the answer was
// available the whole way.
#![enable(implicit_some)]
TerrainDef(
    id: "terrain.salt_flat",
    name: "Salt Flat",
    // Poorer than the ruin-field (50), which until now was the floor.
    // A cutter arm here is very nearly ornamental.
    yield_pct: 35,
    // And richer than the ruin-field (130), which until now was the
    // ceiling. Nothing stands between the roof and the sky — which
    // since the sails were cut buys a fast garden and a bright deck
    // rather than charge.
    sun_pct: 145,
    // Emptiest ground in the game. What is out here is what the sea
    // left, and there is not much of it.
    features_per_100_paces: 5,
    feature_kinds: ["driftwood", "salt_pan", "wreck"],
    // A wreck is a ruin: whatever the sea drove ashore and left, and the
    // only thing out here worth stopping for. One in three features
    // rather than the ruin-field's one in two, so the coast is not a
    // salvage run — it is a long walk with the occasional reason to
    // pause.
    ruin_kinds: ["wreck"],
    // The same range every ruin-bearing band carries. A wreck is a
    // wreck; what differs between the coast and the city is how many of
    // them there are, not what one is worth.
    ruin_salvage_min: 25,
    ruin_salvage_max: 60,
)

// The neutral band: unremarkable yield, unremarkable sun. Neither the
// biomass windfall of the canopy nor the charge windfall of a
// ruin-field.
#![enable(implicit_some)]
TerrainDef(
    id: "terrain.clearing",
    name: "Sunlit Clearing",
    yield_pct: 100,
    sun_pct: 100,
    features_per_100_paces: 8,
    feature_kinds: ["fern", "rock", "tree"],
)

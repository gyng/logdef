// The tower's living core. Pre-placed, unique, and cannot be removed.
// From M2 its destruction ends the run.
#![enable(implicit_some)]
RoomDef(
    id: "room.heartseed",
    name: "Heartseed",
    short: "❤",
    category: Heart,
    // Three slots. It is the tower's reason for walking and the
    // thing everything else is arranged around, so it should take up
    // the room a hearth takes up.
    width: 3,
    unique: true,
)

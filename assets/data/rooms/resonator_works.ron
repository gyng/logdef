// Laminates resin feedstock and fiber into tuned mechanical resonator drums.
//
// Tone, because it matters here more than anywhere else in the pack:
// these are resonators. An array spins and strikes them to roll a low
// pulse across ground a creature has to cross. Nothing in this chain is
// ordnance, and the day it reads as a gun is the day `DECISIONS.md` §8
// has been lost.
#![enable(implicit_some)]
RoomDef(
    id: "room.resonator_works",
    name: "Resonator Works",
    short: "RES",
    // **Opens once the burner is lit**, which is where the opening
    // ends. `SYSTEMS.md` §6.11: a first-turn menu with twenty cards on
    // it is the loudest thing in the game and says nothing, so the menu
    // grows as the tower does. This is a fact about the tower, not the
    // player — the journal (§5.7) is the other kind of unlock and can
    // only filter a menu.
    // Reveal the resin branch only after the roof Garden exists. Fiber
    // and rope remain an economic requirement rather than another gate.
    unlocked_by: "room.garden",
    category: Production,
    width: 2,
    build_cost: [
        CostEntryDef(item: "item.poles", amount: 6),
        CostEntryDef(item: "item.rope", amount: 4),
    ],
    recipe: RecipeDef(
        // Two out of a batch, so an array's appetite is answerable by
        // one room — and slower per unit than a thornwright, so drums
        // are the cheap answer to many things rather than the fast
        // answer to one.
        craft_ticks: 200,
        inputs: [
            IoEntryDef(item: "item.resin_feedstock", amount: 2, buffer_max: 8),
            IoEntryDef(item: "item.fiber", amount: 1, buffer_max: 6),
        ],
        outputs: [IoEntryDef(item: "item.resonator_drums", amount: 2, buffer_max: 8)],
    ),
)

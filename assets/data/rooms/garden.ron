// Grows resin feedstock in the light, and keeps growing while the tower stands
// still.
//
// **The first intake that does not measure ground covered**, and that is
// the entire point of it. The cutter arm, the fiber comb and the salvage
// rig between them mean a stopped tower harvests nothing at all
// (`SYSTEMS.md` §3.6) — which makes berthing at a ruin a pure cost and
// standing at a fork a pure loss. A garden accrues per tick scaled by
// the sun actually reaching the tower, so it is the one thing a parked
// tower does at full rate.
//
// It is also the sun axis finally buying something that is not charge.
// Deep shade is biomass-rich and sun-poor, and since M1 the open
// branches have paid only in charge — a means rather than an end. Now
// they grow the material a thrower scatters.
#![enable(implicit_some)]
RoomDef(
    id: "room.garden",
    name: "Garden",
    short: "GRD",
    // Optional after the survival chain is live: resin opens local
    // storage and resonator choices, but no longer blocks bamboo.
    unlocked_by: "room.burner",
    // The roof bed tends itself at the simulation scale: irrigation,
    // exposure and harvest are already paid in footprint, sunlight and
    // crew hauling. Requiring a permanent gardener made the resin-first
    // branch lose its elevator on all eight measured seeds, so the
    // apparent choice was a labour trap rather than a viable diversion.
    crew_required: 0,
    category: Intake,
    width: 2,
    build_cost: [CostEntryDef(item: "item.poles", amount: 5)],
    // **Roof only.** A garden under three floors of tower is a garden in
    // the dark, and making that a rule rather than a slow trickle keeps
    // it honest. It used to share the roof with the canopy sails; since
    // those were cut it has the deck to itself, and the cost of growing
    // taller is that the garden goes up with you rather than that you
    // choose between the two (`v2-plan.md` §6.3).
    top_floor_only: true,
    intake: IntakeDef(
        item: "item.resin_feedstock",
        // 260 ticks at full sun — about 8.7 seconds a crop — falling to
        // nearly nothing under dense canopy. Scaled by exposure, which
        // is sun *after* terrain: since the sails were cut this is the
        // only thing in the game the sky still pays for, and it pays in
        // food rather than charge.
        source: Sun(ticks_per_item: 260),
        buffer_max: 8,
    ),
)

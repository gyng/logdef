// Turns poles into darts. The first production charge sink in the
// game: a thornwright that never stops crafting is a real, ongoing draw
// on the tower's power, not a rounding error next to striding and
// lights.
#![enable(implicit_some)]
RoomDef(
    id: "room.thornwright",
    name: "Thornwright",
    short: "THN",
    // **Opens once the burner is lit**, which is where the opening
    // ends. `SYSTEMS.md` §6.11: a first-turn menu with twenty cards on
    // it is the loudest thing in the game and says nothing, so the menu
    // grows as the tower does. This is a fact about the tower, not the
    // player — the journal (§5.7) is the other kind of unlock and can
    // only filter a menu.
    unlocked_by: "room.burner",
    category: Production,
    // One slot. A bench, not a mill — small enough to tuck into the
    // gap a three-wide room leaves behind, which is most of where it
    // will end up.
    width: 1,
    build_cost: [CostEntryDef(item: "item.poles", amount: 5)],
    power_draw: 1,
    recipe: RecipeDef(
        // Five seconds a craft against the mill's four, so a
        // thornwright consumes poles a little slower than one mill
        // makes them — on paper. In practice the mill is limited by
        // what the crew can carry to it rather than by its own timer,
        // so a thornwright does out-consume one mill, and a tower that
        // wants darts and repairs both needs a second one. That is a
        // real prerequisite, not an oversight; see BALANCE.md.
        craft_ticks: 150,
        inputs: [IoEntryDef(item: "item.poles", amount: 1, buffer_max: 6)],
        // Three darts to the pole. At one apiece a thornwright turned
        // 96 poles a day into 96 darts — an entire second mill's output
        // — while a battery answering a normal run's waves spent barely
        // forty of them, so the surplus piled up in the storerooms and
        // the tower could not afford to mend itself. Splitting a pole
        // three ways leaves most of that mill for repairs, and keeps
        // shooting cheaper than patching: a skitter costs two darts to
        // put down and does 48 hit points of damage if it is left
        // alone, which is nearly five poles to mend.
        outputs: [IoEntryDef(item: "item.darts", amount: 3, buffer_max: 9)],
    ),
)

// Turns poles into darts. The first production charge sink in the
// game: a thornwright that never stops crafting is a real, ongoing draw
// on the tower's power, not a rounding error next to striding and
// lights.
#![enable(implicit_some)]
RoomDef(
    id: "room.thornwright",
    name: "Thornwright",
    short: "THN",
    category: Production,
    width: 2,
    build_cost: [CostEntryDef(item: "item.poles", amount: 5)],
    power_draw: 1,
    recipe: RecipeDef(
        // 5 seconds a dart. Slower than the mill's 4 s per pole on
        // purpose: one thornwright must never out-consume one mill's
        // output, so the chain stays visibly fed rather than backed up
        // at the mill.
        craft_ticks: 150,
        inputs: [IoEntryDef(item: "item.poles", amount: 1, buffer_max: 6)],
        outputs: [IoEntryDef(item: "item.darts", amount: 1, buffer_max: 6)],
    ),
)

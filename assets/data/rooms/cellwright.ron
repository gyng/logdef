// Winds alloy into charge cells, which are what storage is made of.
//
// Batteries are *built* (`v2-plan.md` §6.1). A cell bank used to cost 8
// poles, which made "I keep browning out at night" a problem you spent
// your way out of; costing cells instead means the answer runs through
// the forge, which costs charge. The first place in the game where
// fixing a problem costs the resource the problem is about.
#![enable(implicit_some)]
RoomDef(
    id: "room.cellwright",
    name: "Cellwright",
    short: "CEL",
    // **Opens once the burner is lit**, which is where the opening
    // ends. `SYSTEMS.md` §6.11: a first-turn menu with twenty cards on
    // it is the loudest thing in the game and says nothing, so the menu
    // grows as the tower does. This is a fact about the tower, not the
    // player — the journal (§5.7) is the other kind of unlock and can
    // only filter a menu.
    unlocked_by: "room.burner",
    category: Production,
    width: 2,
    build_cost: [CostEntryDef(item: "item.poles", amount: 6)],
    recipe: RecipeDef(
        craft_ticks: 300,
        inputs: [IoEntryDef(item: "item.alloy", amount: 2, buffer_max: 6)],
        outputs: [IoEntryDef(item: "item.charge_cells", amount: 1, buffer_max: 4)],
    ),
)

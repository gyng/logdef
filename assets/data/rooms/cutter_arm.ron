// Strips bamboo from the terrain as the tower walks past it. Reaches
// the ground, so it only mounts on the lowest floors — and reaches
// *out*, so it mounts on the front.
//
// **Dual use, and the second use is free.** It is a blade on a boom.
// Anything that climbs onto the floor it is bolted to has climbed into
// the arc of a working blade, so it cuts that too. No ammo, no reload,
// no aiming: the player who built an arm to harvest has already built
// the thing that answers a skitter, and finding that out is a better
// moment than being sold a weapon.
//
// It is also the tone gate doing its work (`DECISIONS.md` §8): the
// tower defends itself with the tools it works with, rather than
// growing a separate set for fighting.
#![enable(implicit_some)]
RoomDef(
    id: "room.cutter_arm",
    name: "Cutter Arm",
    short: "CUT",
    // **Gated behind `room.garden`** — fed the tower before the tower fed itself. The opening
    // ladder is farm, cutter arm, burner, and then the whole
    // menu (`SYSTEMS.md` §6.11).
    unlocked_by: "room.garden",
    category: Intake,
    width: 2,
    max_floor: 1,
    // On the leading edge with the guns (`SYSTEMS.md` §6.13).
    front_only: true,
    // Half a thorn gun's 8, every tick it is working — which sounds
    // small and is not: a battery fires once every 60 ticks, so an arm
    // that keeps cutting for a second does about as much as one dart.
    // The limit is that it only reaches its own floor, and only what is
    // already attached: a wave on the roof of a tall tower is not
    // answered by a boom on the ground.
    melee_damage: 4,
    build_cost: [CostEntryDef(item: "item.poles", amount: 4)],
    intake: IntakeDef(
        item: "item.bamboo",
        // 78 paces a stalk — 130 ticks at the shipped stride on
        // ordinary ground, a little slower than the mill's 120 ticks a
        // pole, so one arm very nearly keeps one mill busy.
        //
        // On ordinary ground. Under dense canopy (yield 140) the same
        // arm cuts every 93 ticks and *does* outrun the mill, and
        // region 1's palette is 55% canopy — so bamboo builds up in the
        // rich stretches and is drawn back down in the poor ones. That
        // is the intended texture rather than an oversight, but it is
        // why a second arm needs a second mill and not just a second
        // storeroom.
        //
        // This used to read 54 (90 ticks), and it was never what the
        // arm actually did. Intake truncated its rate into Q8.8 and ran
        // at 128 ticks, and the whole M2 economy was measured against
        // that figure — an arm marginally slower than the mill, so
        // bamboo never piled up. Fixing the truncation without fixing
        // this number made the arm 33% faster than the mill could
        // consume: bamboo claimed every shelf in the storeroom, and
        // because a shelf holds one kind, poles then had nowhere to go
        // and the chain stopped with the shelves three-quarters full.
        // 78 states the rate the game was balanced around instead of
        // leaving it to a rounding error.
        source: Terrain(paces_per_item: 78),
        buffer_max: 8,
    ),
)

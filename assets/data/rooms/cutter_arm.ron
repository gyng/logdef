// Strips bamboo from the terrain as the tower walks past it. Reaches
// the ground, so it only mounts on the lowest floors.
#![enable(implicit_some)]
RoomDef(
    id: "room.cutter_arm",
    name: "Cutter Arm",
    short: "CUT",
    category: Intake,
    width: 2,
    max_floor: 1,
    build_cost: [CostEntryDef(item: "item.poles", amount: 4)],
    intake: IntakeDef(
        item: "item.bamboo",
        // Per pace, not per tick. The description above was already
        // making this claim — per-tick intake meant a parked tower
        // stripped bamboo out of ground it had already stripped,
        // indefinitely, which was invisible until M3 gave players three
        // reasons to stop on purpose (`SYSTEMS.md` §3.6).
        //
        // 54 paces is exactly the old 90 ticks converted at the tower's
        // 0.6 paces/tick, so a tower that never stops harvests at
        // precisely the rate it did before: one stalk per 3 seconds of
        // walking at ordinary yield, 2.1 s under canopy, 6 s across a
        // ruin-field.
        source: Terrain(paces_per_item: 54),
        buffer_max: 8,
    ),
)

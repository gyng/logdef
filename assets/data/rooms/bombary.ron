// Packs produce and fiber into seed bombs.
//
// Tone, because it matters here more than anywhere else in the pack:
// these are seeds. A thrower scatters them across ground a creature has
// to cross, and what stops the creature is that the ground grows over
// and becomes hard going. Nothing in this chain is ordnance, and the
// day it reads as ordnance is the day `DECISIONS.md` §8 has been lost.
#![enable(implicit_some)]
RoomDef(
    id: "room.bombary",
    name: "Bombary",
    short: "BOM",
    // **Opens once the burner is lit**, which is where the opening
    // ends. `SYSTEMS.md` §6.11: a first-turn menu with twenty cards on
    // it is the loudest thing in the game and says nothing, so the menu
    // grows as the tower does. This is a fact about the tower, not the
    // player — the journal (§5.7) is the other kind of unlock and can
    // only filter a menu.
    unlocked_by: "room.burner",
    category: Production,
    width: 2,
    build_cost: [
        CostEntryDef(item: "item.poles", amount: 6),
        CostEntryDef(item: "item.rope", amount: 4),
    ],
    recipe: RecipeDef(
        // Two out of a batch, so a thrower's appetite is answerable by
        // one room — and slower per unit than a thornwright, so seed
        // bombs are the cheap answer to many things rather than the fast
        // answer to one.
        craft_ticks: 200,
        inputs: [
            IoEntryDef(item: "item.produce", amount: 2, buffer_max: 8),
            IoEntryDef(item: "item.fiber", amount: 1, buffer_max: 6),
        ],
        outputs: [IoEntryDef(item: "item.seed_bombs", amount: 2, buffer_max: 8)],
    ),
)

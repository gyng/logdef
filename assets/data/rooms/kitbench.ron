// Where the tower makes things for its people rather than for itself.
//
// Every other production room turns a material into another material. A
// kitbench turns rope and mechanisms into a **hand lamp**, and a hand
// lamp belongs to Wren — `DESIGN.md` §2 structural call 4 says crew are
// named individuals and not stat blocks, and this is the room where that
// stops being only a claim about the fiction.
//
// **Deliberately behind mechanisms**, which means behind alloy, a forge
// and the ruin belt. Kit is the last thing a tower builds for itself and
// the first thing it builds for somebody, and both halves of that want
// it late: a tower that could equip its crew in the first ten minutes
// would make the kit a starting loadout instead of a decision about a
// person you have come to know.
//
// One recipe, not three. The bench makes lamps; the harness and the
// mender's kit are traded for at enclaves, because a settlement full of
// people who walk for a living is a better source of a carrying frame
// than a workshop is.
#![enable(implicit_some)]
RoomDef(
    id: "room.kitbench",
    name: "Kitbench",
    short: "KIT",
    // **Opens once the burner is lit**, which is where the opening
    // ends. `SYSTEMS.md` §6.11: a first-turn menu with twenty cards on
    // it is the loudest thing in the game and says nothing, so the menu
    // grows as the tower does. This is a fact about the tower, not the
    // player — the journal (§5.7) is the other kind of unlock and can
    // only filter a menu.
    unlocked_by: "room.burner",
    category: Production,
    width: 2,
    build_cost: [
        CostEntryDef(item: "item.poles", amount: 6),
        CostEntryDef(item: "item.rope", amount: 3),
    ],
    // A little charge, like the thornwright: fine work needs light on it.
    power_draw: 1,
    recipe: RecipeDef(
        // Ten seconds. Slower than a pole and faster than a mechanism —
        // a lamp is fiddly rather than heavy.
        craft_ticks: 300,
        inputs: [
            IoEntryDef(item: "item.mechanisms", amount: 1, buffer_max: 3),
            IoEntryDef(item: "item.rope", amount: 1, buffer_max: 3),
        ],
        outputs: [IoEntryDef(item: "item.hand_lamp", amount: 1, buffer_max: 3)],
    ),
)

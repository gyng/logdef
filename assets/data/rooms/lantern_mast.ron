// **The tower that lights its own canopy.**
//
// The upward answer, and the one weapon in the pack that is not a
// weapon. Leapers and gliders come out of the trees onto the upper
// decks, and what stops them is not being shot — it is a mast of lamps
// that makes the branches above the tower somewhere a thing does not
// want to launch from. `DECISIONS.md` §8: defenders rather than
// soldiers, and creatures defending territory rather than a gallery to
// clear. A lantern says *we are awake up here* and the leaper goes
// somewhere else.
//
// It burns charge cells, so a tower that wants the sky covered is a
// tower that has built the alloy chain and is spending its stored
// charge on light instead of on lifts. That is the trade: `Lamps` and
// `Lifts` already compete for the bank (`state/power.rs`), and this
// puts a third claim on the same shelf.
#![enable(implicit_some)]
RoomDef(
    id: "room.lantern_mast",
    name: "Lantern Mast",
    short: "LTN",
    category: Defence,
    // Behind the burner like the rest of the menu, and behind the
    // cellwright in practice, since nothing else makes a charge cell.
    // **Unlocked by the room that feeds it** (`SYSTEMS.md` §6.27). A
    // weapon you cannot supply is a weapon that never fires, and this
    // one costs 5 poles and 2 rope — cheap enough to buy by accident. The menu
    // offers it once the tower can make charge cells, which is a fact about
    // the tower rather than about the player.
    unlocked_by: "room.cellwright",
    // On the leading edge with every weapon (`SYSTEMS.md` §6.13), and
    // the deck reserved for them (§6.21).
    front_only: true,
    top_floor_only: true,
    // Two slots, and the widest thing on the deck: a mast is a mast.
    // `front_slots` is sized against exactly this.
    width: 2,
    build_cost: [
        CostEntryDef(item: "item.poles", amount: 5),
        CostEntryDef(item: "item.rope", amount: 2),
    ],
    defence: DefenceDef(
        ammo: "item.charge_cells",
        ammo_per_shot: 1,
        // **Canopy only, and that is the whole design** (§6.22). It
        // cannot see the ground and it cannot see the legs. A tower that
        // builds nothing but masts has a beautiful roof and loses its
        // shafts.
        targets: [Canopy],
        // Four cells on the rack. A cell is expensive — alloy, a
        // cellwright, a whole chain — so this holds few and asks the
        // haul system for them steadily rather than in a burst.
        buffer_max: 4,
        // Between a thorn gun's 8 and a dart battery's 15. It is not
        // meant to out-damage the battery; it is meant to reach the
        // thing the battery is pointed away from.
        damage: 12,
        // Slow. A lantern is not a rate of fire, it is a presence, and
        // a cell every four seconds is what the chain behind it can
        // actually feed.
        reload_ticks: 120,
        // The light has to reach the launch branches, not only the hull.
        // At 20 paces the mast first noticed leapers after the decision
        // had already become contact; on a 70% canopy route the complete
        // mast package lost 10-12 of 12 held-pressure runs. Sixty gives
        // the repulsion effect room to be preventative rather than a
        // late animation beside an occupied roof.
        range_paces: 60,
        // **The most electric thing on the list** — it fires charge
        // cells and it is, fictionally, a light. Forty a shot against a
        // 120-tick reload is 0.33 a tick, the same sustained load as the
        // array and the ward; the lumpier bite is the point, since a
        // mast firing is the single biggest instantaneous draw a tower
        // has and it is what empties the bucket during a burst.
        charge_per_shot: 40,
        effect: Repel,
    ),
)

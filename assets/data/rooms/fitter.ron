// Makes mechanisms, which are what an elevator is really made of.
//
// The first recipe in the game drawing two inputs from two different
// chains, and the first build cost that is not poles alone. Both of
// those are the tier-two point: by the time a tower can run a fitter it
// has a bamboo chain, a fiber chain and a scrap chain all working, which
// is a different kind of tower from one that has a mill.
#![enable(implicit_some)]
RoomDef(
    id: "room.fitter",
    name: "Fitter",
    short: "FIT",
    // **Opens once the burner is lit**, which is where the opening
    // ends. `SYSTEMS.md` §6.11: a first-turn menu with twenty cards on
    // it is the loudest thing in the game and says nothing, so the menu
    // grows as the tower does. This is a fact about the tower, not the
    // player — the journal (§5.7) is the other kind of unlock and can
    // only filter a menu.
    // Precision manufacture belongs after the forge that supplies its
    // alloy, not in the Burner's first post-opening menu.
    unlocked_by: "room.sun_forge",
    category: Production,
    width: 2,
    build_cost: [
        CostEntryDef(item: "item.poles", amount: 6),
        // Two coils keep precision manufacture dependent on the rope
        // branch without repeating the old whole-chain famine as a
        // four-coil admission charge.
        CostEntryDef(item: "item.rope", amount: 2),
    ],
    recipe: RecipeDef(
        craft_ticks: 300,
        inputs: [
            IoEntryDef(item: "item.alloy", amount: 1, buffer_max: 4),
            IoEntryDef(item: "item.poles", amount: 2, buffer_max: 8),
        ],
        outputs: [IoEntryDef(item: "item.mechanisms", amount: 1, buffer_max: 4)],
    ),
)

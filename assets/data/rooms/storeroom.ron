// Shelves. Each takes whichever item lands on it first and holds only
// that until it empties. Construction spends straight off these
// shelves — the chain pays for the tower.
#![enable(implicit_some)]
RoomDef(
    id: "room.storeroom",
    name: "Storeroom",
    short: "STR",
    // **Behind the cutter arm**, which is the first moment shelves
    // mean anything: before there is bamboo the Heartseed's three
    // shelves are three more than the tower needs. `SYSTEMS.md` §6.11.
    unlocked_by: "room.cutter_arm",
    category: Storage,
    width: 2,
    build_cost: [CostEntryDef(item: "item.poles", amount: 3)],
    storage: StorageDef(
        shelves: 4,
        per_shelf: 20,
    ),
)

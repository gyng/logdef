// The dirty fallback. Turns the contested building material into
// power — burn your poles or build with them. Available at night when
// the sails give nothing; from M2 its smoke raises provocation, which
// is what stops it being a free answer.
#![enable(implicit_some)]
RoomDef(
    id: "room.burner",
    name: "Burner",
    short: "BRN",
    category: Energy,
    width: 2,
    // **A chimney, so it goes up.** The renderer already vents its smoke
    // from the roof above its column — a burner buried under six floors
    // was always fictionally odd, and the plume drawn leaving the top of
    // a tower it was nowhere near was the tell.
    //
    // The mechanical reason is that the chain needed a direction. Intake
    // is pinned to floors 0-1 because it reaches the ground, nothing was
    // pinned high, and so a whole chain could sit beside its own intake
    // and never haul anything upward. A tower that never hauls up has no
    // use for a shaft, whatever the shaft costs.
    //
    // Floor 2 rather than the roof: the sails and the garden are already
    // fighting over the top floor, and a third claimant there would be a
    // rule rather than a decision. Two is enough to put the burner above
    // the bamboo that feeds it.
    min_floor: 2,
    build_cost: [CostEntryDef(item: "item.poles", amount: 5)],
    burner: BurnerDef(
        fuel: "item.bamboo",
        // 100 charge per 100 ticks sustained — close to a sail room's
        // full-day average in good sun, but paid for in bamboo at
        // roughly 2.4x the mill's own appetite for the same stalks. A
        // genuine option, not a trap and not a free win.
        fuel_per_burn: 2,
        charge_per_burn: 100,
        burn_ticks: 100,
    ),
)

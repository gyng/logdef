// Region 2. Sun-rich and barren, with the jungle still visibly taking
// it back — the exact opposite of the deep jungle on both axes, for
// long enough that the tower has to rebuild around it rather than wait
// it out.
//
// Deliberately shorter than region 1: this is a placeholder act, not a
// second full one. M5 adds the third region and the actual arrival
// (`SYSTEMS.md` §3.7).
#![enable(implicit_some)]
RegionDef(
    id: "region.drowned_city",
    name: "The Drowned City",
    order: 1,
    length_min_paces: 34000,
    length_max_paces: 46000,
    ruin_richness_min_pct: 60,
    ruin_richness_max_pct: 140,
    // Four kinds, comfortably clear of the three-kind minimum. Clearing
    // and canopy stay in at low weight because the green reclaiming the
    // concrete is the thing you are meant to be able to see.
    palette: [
        TerrainWeight(terrain: "terrain.drowned_street", weight: 40),
        TerrainWeight(terrain: "terrain.ruin_field", weight: 35),
        TerrainWeight(terrain: "terrain.clearing", weight: 15),
        TerrainWeight(terrain: "terrain.canopy", weight: 10),
    ],
    // Half again as dangerous as the jungle for the same provocation.
    threat_pct: 150,
    // Same rhythm as region 1, so the beat the player learned there
    // still holds. A shorter region simply fits fewer of them: at the
    // low end of the length roll the second fork falls inside
    // `fork_edge_margin_paces` of the far edge and is skipped.
    fork_interval_paces: 15000,
    branches: [
        BranchDef(
            id: "branch.collapsed_district",
            name: "Collapsed District",
            length_paces: 6000,
            palette: [
                TerrainWeight(terrain: "terrain.ruin_field", weight: 55),
                TerrainWeight(terrain: "terrain.drowned_street", weight: 30),
                TerrainWeight(terrain: "terrain.clearing", weight: 15),
            ],
            // Open sky over broken ground: the best charge in the game
            // and almost nothing to cut, with company to match.
            threat_pct: 130,
        ),
        BranchDef(
            id: "branch.flooded_boulevard",
            name: "Flooded Boulevard",
            length_paces: 6000,
            palette: [
                TerrainWeight(terrain: "terrain.drowned_street", weight: 60),
                TerrainWeight(terrain: "terrain.ruin_field", weight: 25),
                TerrainWeight(terrain: "terrain.clearing", weight: 15),
            ],
            // The city at its most itself. Ordinary danger, ruins
            // throughout.
            threat_pct: 100,
        ),
        BranchDef(
            id: "branch.green_terraces",
            name: "Green Terraces",
            length_paces: 6000,
            palette: [
                TerrainWeight(terrain: "terrain.canopy", weight: 50),
                TerrainWeight(terrain: "terrain.clearing", weight: 25),
                TerrainWeight(terrain: "terrain.drowned_street", weight: 25),
            ],
            // Where the jungle won. A stretch of the mill's own weather
            // in the middle of the city, and quieter for it.
            threat_pct: 80,
        ),
    ],
    // A short way in rather than on the boundary. On the boundary the
    // enclave would put scrap's only consumer upstream of the only
    // region that produces much scrap, so everything salvaged past it
    // would be dead weight — the milestone punishing the player for
    // engaging with the thing it is about (`SYSTEMS.md` §3.5).
    //
    // 8,000 paces is about seven minutes of 1x walking past the
    // boundary: one or two of the city's ruins, so arriving with
    // something to trade is the normal case, and four-fifths of the
    // region is still ahead of you to be provisioned for.
    enclave: EnclaveDef(
        id: "enclave.high_water",
        name: "High Water",
        at_paces: 8000,
        // Neighbours, not a merchant's inventory. Every rate here is
        // worse than the chain's own — a mill turns bamboo into poles
        // one for one, a thornwright turns a pole into three darts — so
        // this is where a tower that lacks a room buys around the gap
        // once, not a substitute for building it. Finite stock, so it
        // is a windfall rather than an exchange to farm.
        offers: [
            // The payoff for everything in §3.4, and the reason scrap
            // exists at all in M3. A 40-unit ruin comes to 30 poles.
            OfferDef(
                give: CostEntryDef(item: "item.scrap", amount: 4),
                take: CostEntryDef(item: "item.poles", amount: 3),
                stock: 20,
            ),
            OfferDef(
                give: CostEntryDef(item: "item.bamboo", amount: 10),
                take: CostEntryDef(item: "item.poles", amount: 4),
                stock: 10,
            ),
            OfferDef(
                give: CostEntryDef(item: "item.poles", amount: 4),
                take: CostEntryDef(item: "item.darts", amount: 6),
                stock: 12,
            ),
        ],
        // One pair of hands, priced steeply. Going from two crew to
        // three moved measured throughput by ninety percent
        // (`BALANCE.md`, `starting_crew`), so a fourth is the largest
        // single change a player can buy and should cost like it.
        // Shell work, twice, for the city's own metal.
        //
        // The only permanent upgrade in the game, and the one thing
        // that gives scrap somewhere to go besides the trade board. A
        // run that berths at the city's ruins arrives here with metal;
        // this turns it into hull. Sixty hit points a round is 40% of
        // a panel, so two rounds take every floor from 150 to 270 —
        // nearly double, which is what makes region 2's half-again
        // threat land on a tower that can take it.
        //
        // Eighteen scrap a round is most of one good ruin, so plating
        // twice means berthing at least twice and getting away with it
        // both times.
        // NOT OFFERED. The shell work is built, tested and drawn, and
        // it is *harmful*: measured across eight seeds, a tower plated
        // twice ends three days at provocation 100 having lost between
        // 958 and 2,232 hit points where the same tower unplated loses
        // between 0 and 8. Worse on every seed tried, by two to three
        // orders of magnitude, and it repairs less while damaged more.
        //
        // The mechanism is not understood — see the note at the head of
        // `BALANCE.md`'s Siege section, and reproduce with the last
        // section of `cargo run --release -p understory-core --example
        // siege_run`. Until it is, this must not be purchasable: an
        // upgrade that makes the tower worse at the one thing it is
        // sold for is a trap, and shipping a trap is worse than
        // shipping nothing.
        //
        // Restore by uncommenting. The code, the command, the tests and
        // the plating on the hull are all in place and stay that way,
        // so the fix is a diagnosis rather than a rebuild.
        //
        // reinforce: ReinforceDef(
        //     cost: [CostEntryDef(item: "item.scrap", amount: 18)],
        //     panel_hp: 60,
        //     times: 2,
        // ),
        recruits: 1,
        recruit_cost: [CostEntryDef(item: "item.poles", amount: 30)],
    ),
)

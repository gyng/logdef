// What the middle bands give up.
//
// The third raw material, and the one that is not an extreme: bamboo
// comes from deep shade, produce from open sun, and fiber from the
// ordinary ground in between. That placement is the whole point of it —
// rope is what every shaft and every emplacement is partly made of, so
// the tower that can build transport is the one that walked through
// unremarkable country rather than optimising for either end of the
// route axis (`SYSTEMS.md` §5.3).
#![enable(implicit_some)]
ItemDef(
    id: "item.fiber",
    name: "Fiber",
    glyph: "🧵",
    // Beside bamboo (10), because the two are the same kind of thing:
    // something the ground gives you as you walk over it.
    order: 12,
)

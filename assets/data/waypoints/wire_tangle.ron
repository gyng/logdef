// Old cable, worth taking if you have something to cut it with.
//
// **The one with a price**, and the price is the material every chain
// in the game competes for. Trading poles for mechanisms is the only
// way to get mechanisms without a fitter, which makes this the
// waypoint a tower without that chain actually wants — and the one a
// tower that has built it can walk past.
#![enable(implicit_some)]
WaypointDef(
    id: "waypoint.wire_tangle",
    name: "Wire Tangle",
    said: "Cable, coiled in the roots. Worth cutting free, if you can spare the bracing.",
    take: "Cut it free",
    costs: [CostEntryDef(item: "item.poles", amount: 4)],
    gives: [CostEntryDef(item: "item.mechanisms", amount: 2)],
    provocation: 10,
    paces: -110,
)

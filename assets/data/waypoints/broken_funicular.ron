// A dead haulage line, collapsed into useful stock.
//
// Four poles here and six at the tool cradle preserve the old waypoint
// set's expected pole gift exactly: (4 + 5 + 6) / 12 is the same 1.25
// poles per beat as the Fallen Carrier's 5 / 4. More authored variety
// must not quietly make the recorder — or an opening tower — poorer.
#![enable(implicit_some)]
WaypointDef(
    id: "waypoint.broken_funicular",
    name: "Broken Funicular",
    said: "A cable carriage lies folded beneath its drive rail. The frame still rings true. Strip it?",
    take: "Strip the frame",
    costs: [],
    gives: [CostEntryDef(item: "item.poles", amount: 4)],
    provocation: 15,
    paces: -100,
)

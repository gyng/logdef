#![enable(implicit_some)]
DaypartDef(
    id: "daypart.morning",
    name: "Morning",
    start_permille: 180,
    // Day shift begins. The longer band (8,352 ticks against the
    // night's 6,048), which is the day worker's compensation for
    // spending nearly all their rest on one shift.
    shift: Day,
)

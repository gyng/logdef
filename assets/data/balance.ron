// Understory — balance constants.
//
// Every value here is graded in docs/BALANCE.md, and a test fails if a
// field appears in one and not the other. No floating point: rates are
// written the way a designer thinks about them ("ticks per item",
// "paces per 100 ticks") and converted to fixed point at use.
//
// The simulation runs at 30 ticks per second.
#![enable(implicit_some)]
Balance(
    world: WorldBalance(
        // 0.6 paces/tick — a stately 18 paces a second. The horizon
        // should change while you watch, not while you blink.
        stride_paces_per_100_ticks: 60,
        // 16–50 seconds in a band at 1x, so terrain has time to matter
        // before it changes.
        band_min_paces: 300,
        band_max_paces: 900,
        stream_ahead_paces: 900,
        stream_behind_paces: 300,
    ),
    tower: TowerBalance(
        starting_floors: 4,
        // Cozy scale: the whole tower stays on one screen.
        max_floors: 14,
        floor_slots: 8,
        floor_cost: [CostEntryDef(item: "item.poles", amount: 6)],
        // One body on the stairs at a time. Two crew is already a
        // queue, which is the whole thesis in miniature.
        stairs_capacity: 1,
        // **Sixteen, raised from ten when the sails were cut.**
        //
        // Ten was sized against a tower whose charge arrived free from
        // the roof. M6 made the burner the only income, so the opening
        // tower now has a third mouth for its bamboo and the mill
        // rebuilds the pole buffer more slowly — and poles are what
        // mends a room.
        //
        // The failure that set this number is worth keeping: measured
        // on the golden recorder's seed, the tower's **only** cutter
        // arm was wrecked at around tick 18,000 with one pole on the
        // shelves, and that is terminal in a way nothing else in the
        // game is. Repair wants poles, poles want the mill, the mill
        // wants bamboo, and bamboo wants the arm that just died. The
        // tower walked for another 40,000 ticks with every buffer
        // empty.
        //
        // Six more poles is one mend, which is all it has to be: this
        // buys the opening the slack the sails used to provide, and
        // does not touch any rate.
        starting_stock: [CostEntryDef(item: "item.poles", amount: 16)],
    ),
    crew: CrewBalance(
        // Three, not two. Two crew on a one-body staircase queue, but
        // only just — measured throughput barely moved when a second
        // shaft was added, which made M1's whole sprint question
        // unanswerable. Three puts real pressure on the stairs and
        // makes relieving them worth the poles.
        starting_crew: 3,
        // Eight, which the rota earns. Eight split across two shifts is
        // about five awake at once, which is where six unrota'd crew
        // already sat — so raising the cap without the rota would have
        // been a straight throughput gift, and with it it buys coverage.
        crew_cap: 8,
        // 0.4s per slot: crossing an 8-wide floor costs about 3
        // seconds, enough that where you put things matters.
        walk_ticks_per_slot: 12,
        // A full second per floor. Stairs are slow on purpose — that
        // is the pressure the dumbwaiter relieves in M1.
        climb_ticks_per_floor: 30,
        // Half a second more per item on your back, per floor: an empty
        // climber takes 30 ticks a floor, a fully laden one 75.
        //
        // **The staircase used to be a perfectly good freight line**,
        // and that is why neither built shaft had a job. Measured on
        // `examples/lift.rs`: with this at 0 an elevator was worth +1%
        // at five floors and was not chosen at all at eight or eleven,
        // where crew queued sixty thousand crew-ticks on the stairs
        // beside a powered, empty car. It only paid at fourteen floors,
        // which no tower reaches.
        //
        // Per item rather than a flat laden rate, so `carry_capacity`
        // still means something and bulk still wins — three items in one
        // trip costs 75 a floor against three trips at 45, or crew would
        // start ferrying singles to game the rate.
        //
        // Chosen over raising `climb_ticks_per_floor` to 45, which moves
        // the same break-even but taxes a crew member walking to dinner
        // as hard as one hauling poles. What has to get expensive is
        // *freight up a staircase*, not being on a staircase.
        climb_ticks_per_item: 15,
        load_ticks: 15,
        unload_ticks: 15,
        carry_capacity: 3,
        // Two seconds blocked and the cross-section tints them red.
        stress_ticks: 60,
        // Half again with somebody standing in the room working it.
        // Enough that posting a person is visibly worth it, never so
        // much that a manned room outruns its supply — a mill at 150%
        // still eats one bamboo a craft, so a station moves the
        // bottleneck onto the chain feeding it rather than removing it.
        //
        // **The price is the person.** Three crew and one staircase
        // means posting somebody is a standing decision to take a porter
        // off the stairs, which is `DESIGN.md` insight 1 made explicit
        // rather than a cost bolted on.
        manned_work_pct: 150,
        // A third of a day, so three meals a day a person. Short enough
        // that the canteen is somewhere people actually go, long enough
        // that eating is not most of what a crew member does.
        hungry_ticks: 4800,
        // Half a day — a full meal cycle *past* being hungry. A working
        // kitchen never reaches it, so the slow-down is a failure signal
        // rather than a routine tax, and a fed tower never sees it.
        starving_ticks: 7200,
        // 0.6 of a day, a shade over the 8,352-tick day shift, so a day
        // worker ends their shift nearly empty and a night worker (6,048
        // ticks awake) never does.
        rested_max_ticks: 8640,
        // A tenth of a day of work left. A bunked day worker crosses it
        // about four-fifths through their shift, so the tower flags in
        // the late afternoon and picks up at dawn. That is the day
        // having a shape, not a balance oversight.
        tired_ticks: 1440,
        // Two ticks of rest a tick asleep: 6,048 off shift refills
        // 12,096, comfortably over the cap. A bunk should feel like a
        // solved problem rather than a managed one.
        rest_gain_per_tick: 2,
        // Bunkless is a net loss of 2,304 a day and permanent tiredness
        // inside four. Visibly degrading, never fatal, and fixable for
        // three poles at any moment.
        no_bunk_rest_gain: 1,
        // Past starving_ticks everything takes about two-thirds longer.
        // Plainly slower on screen without reading as broken.
        hungry_work_pct: 60,
        // The same figure as hunger's, on purpose. One visible failure
        // mode with two causes.
        tired_work_pct: 60,
        // The mildest of the three — you can work by feel, just not
        // well. Composed with the other two the worst case is 27%:
        // crawling, never stopped, because a need that halts the tower
        // is a death spiral rather than a pressure.
        dark_work_pct: 75,
    ),
    clock: ClockBalance(
        // 8 minutes at 1x, 2 minutes at 4x — about 20 day cycles
        // across a 3-hour run, enough for the sun/route tension to
        // repeat many times without a single day feeling like the
        // whole session.
        ticks_per_day: 14400,
        // (permille_of_day, sun_pct) anchors, linearly interpolated.
        // Dark for the first tenth of the day, rising through the
        // morning, peak at midday, falling away by dusk, dark again
        // for the last fifteenth. A curve, not a staircase, so no
        // daypart boundary reads as a lighting bug.
        sun_curve: [
            (0, 0),
            (100, 0),
            (200, 40),
            (400, 90),
            (500, 100),
            (700, 60),
            (850, 10),
            (1000, 0),
        ],
        // Below 20% exposure the tower needs lamps lit. Against the
        // curve above, that's roughly the last third of the day —
        // long enough that unlit floors are a real cost, short enough
        // that a competent tower shrugs it off most nights.
        night_light_threshold: 20,
    ),
    power: PowerBalance(
        // **The floor under the economy.** Six per 100 ticks against
        // striding's 20 and a starting tower's ~22 of total draw: not
        // an income, a limp. A tower living on this alone walks about
        // one block in four and runs nothing.
        //
        // It exists because cutting the sails made every source of
        // charge depend on already having charge — the burner eats
        // bamboo, bamboo is harvested from ground covered, and a tower
        // too poor to walk covers no ground. Measured on `journey.rs`
        // seed 1 before this existed: charge 4/2300 and the tower
        // parked at one pace for 160,000 ticks with no way back.
        //
        // Raising it towards 20 makes walking free and deletes the
        // bank-or-burn decision; the useful range is well under half
        // the stride cost.
        heartseed_charge_per_100_ticks: 6,
        // Enough to outlast the dark stretch at the top of a fresh
        // run (tick 0 is predawn) — a starting tower's base draw
        // (stride + lighting four floors) is ~0.28 charge/tick, so
        // 800 covers the ~2,200 ticks until real daylight with room
        // to spare, but nowhere near enough to also run a thornwright
        // unattended.
        //
        // Since the sails were cut this is also the whole of the
        // opening budget: a tower with no burner has 800 charge and no
        // way to make more, so the first burner is a deadline rather
        // than an upgrade.
        starting_charge: 800,
        // Continuous striding costs 2,880 charge across a full day —
        // against one burner's 28,800, so a single burner walks the
        // tower ten times over and the cost lands as fuel hauled
        // rather than as a wall. Visible and ongoing, which is what
        // makes stopping to bank a genuine choice.
        stride_charge_per_100_ticks: 20,
        // Small per floor, but multiplies with height: an 8-floor
        // tower lit through a full night spends ~760 charge, enough
        // that a brown-out reads as "the tower outgrew what it can
        // light."
        light_charge_per_100_ticks_per_floor: 2,
    ),
    transport: TransportBalance(
        // A third of a second of doors-and-landing overhead before
        // anyone moves — enough to read as a stop, not enough to make
        // every trip feel like a wait.
        dwell_base_ticks: 10,
        // Cheaper than a full load_ticks/unload_ticks (15) — boarding
        // a car is simpler than working a shelf — but a full 4-unit
        // car still adds 24 ticks to a stop, visibly slower than an
        // empty one.
        dwell_per_unit_ticks: 6,
        // Matches starting_crew: with two crew, a car that leaves for
        // the first caller would never show contention at all, which
        // is the exact thing M1's sprint question is testing.
        dispatch_threshold: 2,
        // 3 seconds. A lone caller on a quiet floor still gets
        // served — batching creates the queue, it shouldn't strand
        // anyone.
        dispatch_max_wait_ticks: 90,
        // 2 seconds added to a stairs estimate at capacity — enough
        // to make crew prefer a second shaft once one exists, without
        // making one occupied staircase look catastrophic.
        queue_penalty_ticks: 60,
        // 1.5 seconds, a rough midpoint between "the car is right
        // here" and "the car is at the far end of its run" — the
        // estimate crew use before the car's actual position
        // sharpens it.
        elevator_base_wait_ticks: 45,
    ),
    siege: SiegeBalance(
        // Two thirds of a second at 1x, and still a sixth of one at 4x
        // — enough frames that a kill is something you see rather than
        // something you infer from the counter going up.
        enemy_fade_ticks: 20,
        // Four seconds of standing in the room. Long enough that
        // answering a thief is a real call on somebody's time — they
        // walk there, they stand there, and the stairs are short a
        // porter throughout — and short enough that a crow is not
        // answered by losing a person for the afternoon.
        //
        // **The whole of what a person does about a thief.** Nobody
        // fights: `DECISIONS.md` §8 has defenders rather than soldiers
        // and creatures defending their territory rather than a gallery
        // to clear, so a crow that finds somebody in the room simply
        // goes, the way it would if you walked into your own kitchen.
        shoo_ticks: 120,
        // A floor's outer skin. Cheap enough that losing one to an
        // unanswered wave is a scrape: repairing it from nothing costs
        // 15 poles and 600 ticks of crew time (see the repair fields
        // below), against a whole floor's build cost of 6 — dearer than
        // building fresh, as fiddly work on something already standing
        // should be, but not so dear that a breach is a catastrophe.
        panel_hp: 150,
        // Not quite twice a panel's health — rooms sit behind the
        // skin, so it should take real work to reach one once its
        // floor's panel is already down.
        room_hp: 260,
        // Four times a panel's health. Severing a shaft is the
        // signature emergency (SYSTEMS.md §2.3) and must never be one
        // bite: a lone root-borer chewing uninterrupted (18 damage
        // every 70 ticks, see enemies/root_borer.ron) needs about
        // 2,333 ticks — roughly 78 seconds — to take a shaft from full
        // health to severed.
        shaft_hp: 600,
        // Well over six times a shaft column's health. The Heartseed
        // is the loss condition; nothing should reach it by accident,
        // and nothing should finish it quickly once something does.
        heartseed_hp: 4000,
        // The tower strides 0.6 paces/tick (world.stride_paces_per_100_ticks
        // above). 540 paces / 0.6 = 900 ticks = 30 s at 1x, comfortably
        // inside a 20-40 s reaction window between the wave-arrival
        // sound cue and contact. A creature's own approach speed
        // (EnemyDef.speed_paces_per_100_ticks) closes a little more of
        // the gap on top of the tower's own stride, which is why the
        // fast night prowler reaches contact sooner than the slow
        // root-borer despite spawning at the same distance.
        spawn_paces_ahead: 540,
        // Three a day-cycle (ticks_per_day 14400 / 4800), 160 seconds
        // apart at 1x.
        //
        // Six a day was too many to be punctuation. An opening-strength
        // wave does about 192 damage, which costs 19 poles to mend; one
        // mill makes about 20 poles in 2,400 ticks at its nominal rate
        // and rather fewer once haul latency is counted. So at the old
        // interval a tower's entire pole income went on its own skin,
        // it could never build anything again, and a damaged mill
        // turned that into a spiral it could not climb out of — which
        // is what a recorded run actually did: 0 poles in the bank
        // against a 120-pole repair bill. At 4,800 the same tower
        // spends about a quarter of its income staying whole and keeps
        // the rest.
        wave_interval_ticks: 4800,
        // Every 100 points of provocation buys 40 more threat budget.
        // At provocation_max (1000) that is +400 on top of
        // base_threat — a wave more than twenty times richer than the
        // opening one. This is the "aggressive harvester in real
        // trouble" case BALANCE.md reasons about.
        threat_per_100_provocation: 40,
        // The floor under a wave, once one is coming at all: 10 threat
        // buys two skitters (5 each — see enemies/skitter.ron). A wave
        // is never a single creature, but a barely-provoked tower gets
        // a pair rather than a pack, and the ramp to four and beyond is
        // something the player earns by playing loudly.
        //
        // This used to be 20 and unconditional, which meant the very
        // first point of provocation bought a full four-skitter wave.
        // Waves are now gated on the provocation-scaled budget being
        // able to afford something on its own, and this is only the
        // floor under that.
        base_threat: 10,
        // The ceiling every provocation-scaled field below is a
        // fraction of. Round, so "a third" (canopy leaper) and "half"
        // (root-borer) land on clean gate values.
        provocation_max: 1000,
        // 2.4 points an item, calibrated so that one cutter arm in
        // region 1 breaks even against the decay below and the second
        // one is what provokes.
        //
        // Was 300, set when a one-arm tower was measured at ~101 items
        // a day. Two things moved that figure at M3 and both pushed the
        // same way. Intake used to truncate its rate into Q8.8 and run
        // the arm at 128 ticks rather than its authored 90; fixing that
        // meant authoring the arm at the rate it had really been
        // running (78 paces, 130 ticks — see rooms/cutter_arm.ron), so
        // the rate itself barely moved. What did move is that the yield
        // multiplier started working at all: `Fx(2) * 1.40` had been
        // `Fx(2)`, so dense canopy and open clearing harvested
        // identically, and region 1's palette is 55% canopy. A
        // subsistence tower gained about 15% more a day overnight, and
        // at 300 that was enough to tip it from quiet into climbing —
        // measured, provocation 221 and 824 per-mille standing by day
        // five, for a tower that had done nothing but exist.
        //
        // **M4 moved it again, and by more than either M3 change did.**
        // Crew now sleep through the night band and stop to eat, and a
        // canteen draws a fifth of a mill's bamboo, so the tower on the
        // other side of this constant is a materially slower one:
        // measured across three seeds over five days on a fed and rested
        // tower, one cutter arm brings in ~69 items a day and two bring
        // in ~97, against the ~120 and ~210 the figure of 240 was sized
        // for. Break-even at 240 is 120 items a day, which two arms now
        // sit *below* — so the knob had quietly stopped turning at all,
        // and no amount of harvesting could draw a wave.
        //
        // 300 is what puts the three-way shape back. It is not the value
        // the old arithmetic would suggest, and the reason is worth
        // writing down: **sleep made provocation spiky.** Harvest now
        // arrives entirely inside the day band while decay runs around
        // the clock, so what draws a wave is the mid-afternoon *peak*,
        // not the daily mean, and the two no longer move together. At
        // 370 — the value break-even arithmetic gives — one arm's peak
        // cleared the wave threshold every afternoon and a subsistence
        // tower took 210 hit points on day one, which is not what
        // "living within its means" is supposed to buy. At 300 the peak
        // stays under it.
        //
        // The shape at 300, over five days from this seed: subsistence
        // never rises above 6 and ends whole at 999 per-mille; greedy —
        // a second arm and no second mill — peaks at 56, jams on its own
        // shelves by day 3, and is eaten down to 62 per-mille with
        // nothing to answer with; answered holds 809 per-mille and sees
        // off 15. Re-measured with
        // `cargo run --release -p understory-core --example siege_run`.
        provocation_per_100_harvested: 300,
        // **12, down from 18 when the sails were cut, and the
        // reasoning changed completely underneath it.**
        //
        // 18 priced the burner as the *dirty option*: a tower that ran
        // one all night was choosing to be loud. Cutting the sails
        // made the burner the only income, so every tower burns now
        // and the premium landed on something nobody can avoid.
        //
        // **This is the constant that decided whether the opening
        // tower lives.** Measured on the golden recorder's seed with
        // everything else held: at 18 the tower's only cutter arm was
        // wrecked by tick 18,000 and never mended, which is terminal
        // in a way nothing else in the game is — repair wants poles,
        // poles want the mill, the mill wants bamboo, and bamboo wants
        // the arm that just died. At 10 it survived poor (6 poles at
        // tick 57,000). At 6 it thrived (52 poles, 103 crafts, every
        // room at full health). Setting it to 0 and changing nothing
        // else was the run that proved smoke was the cause rather than
        // fuel: 21 poles, 63 crafts, no damage anywhere.
        //
        // 12 is that 6 carried up alongside `charge_per_burn`'s move
        // from 400 to 800 — half as many burns for the same charge, so
        // the smoke per unit of power is exactly the 6-at-400 that
        // measured healthy. **Those two are one constant in two
        // columns; move them together or you silently retune the
        // siege.** It is the same failure `SYSTEMS.md` §5.11 open
        // question 0 records for `yield_pct` and `sun_pct`.
        //
        // `BALANCE.md` already flagged 18 as unargued-for: it was 6
        // before M3 scaled it alongside `provocation_per_100_harvested`
        // and was never re-derived. This is that row being cashed in.
        //
        // What replaces the old premium is better anyway: a burner
        // idles on a full bank, so burns track what the tower
        // *spends*. Striding hard, lighting ten floors and running a
        // forge all smoke; a parked tower with a full bank does not.
        // The pressure comes from working the tower hard rather than
        // from a flag on one room.
        //
        // What changed underneath is better: the burn count now
        // tracks what the tower *spends* rather than wall-clock time,
        // so striding hard and running a forge smoke, and a parked
        // tower with a full bank does not.
        provocation_per_burn: 12,
        // A quarter louder per unit than cutting
        // (provocation_per_100_harvested, above, is 240). Taking a ruin
        // apart is noisier work than stripping a stand of bamboo, and a
        // little noisier is the whole of the difference: the wardens a
        // ruin rouses are already the price of that ruin, and charging
        // a much louder second price in provocation on top would make
        // salvage a thing nobody does twice.
        //
        // The two were deliberately equal when both read 300. Cutting
        // came down to 240 when the yield multiplier started working
        // and a subsistence tower began provoking on its own; salvage
        // did not need the same correction, because a berth harvests
        // nothing from the terrain while it happens.
        provocation_per_100_salvaged: 300,
        // 14,400 ticks / 100 x 2 = 288 points a day, a little under a
        // third of the ceiling. Set so that a subsistence tower — one
        // cutter arm, no burner — hovers at zero, and so that a tower
        // which stops provoking and just walks is back to quiet inside
        // four days however loud it had been. Everything above is a
        // multiple of this number; change it and the whole dial moves.
        provocation_decay_per_100_ticks: 2,
        // Four ticks a hit point — about a seventh of a second.
        // Fully repairing a severed shaft (600 hp) costs 2,400 ticks,
        // 80 seconds of one crew member's dedicated time: real
        // competition against hauling, not a rounding error.
        repair_ticks_per_hp: 4,
        // One pole per ten hit points: re-skinning a breached panel
        // (150 hp) costs 15 poles and rebuilding a severed shaft
        // (600 hp) costs 60.
        //
        // Repair is dearer per unit than building fresh — a floor
        // costs 6 poles all in (see the Tower section above) — because
        // it is fiddly work on something already standing. But only
        // about twice as dear. At the original 2 a panel cost 30, five
        // times a whole floor, and a tower visited at the usual rate
        // spent every pole one mill could make on putting its own skin
        // back and could never build anything again. Halving it puts
        // an undefended tower at roughly break-even: it can survive
        // indefinitely by patching, but it will not grow until it
        // answers the jungle some other way.
        repair_poles_per_10_hp: 1,
        // Twenty hit points a shift, so a shift is 80 ticks of crew
        // time and 2 poles. Chunky on purpose: a crew member who
        // commits to a repair is away from hauling for a noticeable
        // stretch, which is what makes triage a decision. Per-tick
        // repair would let them dip in and out for free.
        //
        // It is also the threshold below which crew do not bother: a
        // shift costs its poles whether it mends twenty points or one,
        // so anything missing less than this is left alone and the mark
        // stays on the tower.
        repair_hp_per_shift: 20,
        // A quarter health. A room keeps limping along above this —
        // damaged, slower, but still contributing (SYSTEMS.md §2.3) —
        // and only goes fully silent once it crosses this line, so the
        // player sees a visible decline before the room stops rather
        // than a surprise cliff.
        wrecked_permille: 250,
    ),
    // The handful of journey-wide constants that belong to no single
    // room and no single creature. See SYSTEMS.md §3.3-§3.5.
    journey: JourneyBalance(
        // A third of a fork interval (15,000, see
        // regions/deep_jungle.ron). A fork this close to a region edge
        // or to the region's enclave is skipped, so a decision never
        // lands on top of a boundary or a berth and competes with it
        // for the same stretch of horizon. Sized to keep region 2's
        // first fork (15,000 in) clear of the enclave (8,000 in) while
        // still dropping the second one on a short length roll — which
        // is how the rolled length turns into "how many decisions does
        // this region ask".
        fork_edge_margin_paces: 1400,
        // About a five-second window at 1x, under two at 4x — the tower
        // covers 80 paces in 133 ticks. If that reads as fiddly in
        // play, the answer is a larger number, not an approach-and-dock
        // mechanic.
        enclave_berth_paces: 80,
        // A 25-unit ruin rouses one warden (25 x 120 / 100 = 30, one
        // warden's threat exactly); a 50-unit ruin rouses two. The
        // payout and the price are the same number, which is what makes
        // "is this ruin worth it" a question about the tower rather
        // than about the ruin.
        warden_threat_per_100_salvage: 120,
        // About twenty seconds between the ground moving and the first
        // bite, at a warden's own 20 paces per 100 ticks — the same
        // order of warning spawn_paces_ahead gives an ordinary wave,
        // bought at a much shorter distance because a warden is slow.
        warden_wake_paces: 120,
    ),
)

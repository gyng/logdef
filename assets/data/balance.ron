// Understory — balance constants.
//
// Every value here is graded in docs/BALANCE.md, and a test fails if a
// field appears in one and not the other. No floating point: rates are
// written the way a designer thinks about them ("ticks per item",
// "paces per 100 ticks") and converted to fixed point at use.
//
// The simulation runs at 30 ticks per second.
#![enable(implicit_some)]
Balance(
    world: WorldBalance(
        // 0.6 paces/tick — a stately 18 paces a second. The horizon
        // should change while you watch, not while you blink.
        stride_paces_per_100_ticks: 60,
        // 16–50 seconds in a band at 1x, so terrain has time to matter
        // before it changes.
        band_min_paces: 300,
        band_max_paces: 900,
        stream_ahead_paces: 900,
        stream_behind_paces: 300,
    ),
    tower: TowerBalance(
        starting_floors: 4,
        // Cozy scale: the whole tower stays on one screen.
        max_floors: 14,
        floor_slots: 8,
        floor_cost: [CostEntryDef(item: "item.poles", amount: 6)],
        // One body on the stairs at a time. Two crew is already a
        // queue, which is the whole thesis in miniature.
        stairs_capacity: 1,
        starting_stock: [CostEntryDef(item: "item.poles", amount: 10)],
    ),
    crew: CrewBalance(
        // Three, not two. Two crew on a one-body staircase queue, but
        // only just — measured throughput barely moved when a second
        // shaft was added, which made M1's whole sprint question
        // unanswerable. Three puts real pressure on the stairs and
        // makes relieving them worth the poles.
        starting_crew: 3,
        // Twice the starting three, and short of the plan's eventual
        // eight, which M4's shift rota should have to earn. The
        // enclave's single recruit is the only way to move toward it in
        // M3, so this is a ceiling with plenty of headroom rather than
        // one a run will reach.
        crew_cap: 6,
        // 0.4s per slot: crossing an 8-wide floor costs about 3
        // seconds, enough that where you put things matters.
        walk_ticks_per_slot: 12,
        // A full second per floor. Stairs are slow on purpose — that
        // is the pressure the dumbwaiter relieves in M1.
        climb_ticks_per_floor: 30,
        load_ticks: 15,
        unload_ticks: 15,
        carry_capacity: 3,
        // Two seconds blocked and the cross-section tints them red.
        stress_ticks: 60,
    ),
    clock: ClockBalance(
        // 8 minutes at 1x, 2 minutes at 4x — about 20 day cycles
        // across a 3-hour run, enough for the sun/route tension to
        // repeat many times without a single day feeling like the
        // whole session.
        ticks_per_day: 14400,
        // (permille_of_day, sun_pct) anchors, linearly interpolated.
        // Dark for the first tenth of the day, rising through the
        // morning, peak at midday, falling away by dusk, dark again
        // for the last fifteenth. A curve, not a staircase, so no
        // daypart boundary reads as a lighting bug.
        sun_curve: [
            (0, 0),
            (100, 0),
            (200, 40),
            (400, 90),
            (500, 100),
            (700, 60),
            (850, 10),
            (1000, 0),
        ],
        // Below 20% exposure the tower needs lamps lit. Against the
        // curve above, that's roughly the last third of the day —
        // long enough that unlit floors are a real cost, short enough
        // that a competent tower shrugs it off most nights.
        night_light_threshold: 20,
    ),
    power: PowerBalance(
        // Enough to outlast the dark stretch at the top of a fresh
        // run (tick 0 is predawn) — a starting tower's base draw
        // (stride + lighting four floors) is ~0.28 charge/tick, so
        // 800 covers the ~2,200 ticks until real daylight with room
        // to spare, but nowhere near enough to also run a thornwright
        // unattended.
        starting_charge: 800,
        // Continuous striding costs 2,880 charge across a full day —
        // real money next to a two-sail day's ~20,000 income, but not
        // so much that walking is unaffordable. Visible and ongoing,
        // which is what makes stopping to bank a genuine choice.
        stride_charge_per_100_ticks: 20,
        // Small per floor, but multiplies with height: an 8-floor
        // tower lit through a full night spends ~760 charge, enough
        // that a brown-out reads as "the tower outgrew what it can
        // light."
        light_charge_per_100_ticks_per_floor: 2,
    ),
    transport: TransportBalance(
        // A third of a second of doors-and-landing overhead before
        // anyone moves — enough to read as a stop, not enough to make
        // every trip feel like a wait.
        dwell_base_ticks: 10,
        // Cheaper than a full load_ticks/unload_ticks (15) — boarding
        // a car is simpler than working a shelf — but a full 4-unit
        // car still adds 24 ticks to a stop, visibly slower than an
        // empty one.
        dwell_per_unit_ticks: 6,
        // Matches starting_crew: with two crew, a car that leaves for
        // the first caller would never show contention at all, which
        // is the exact thing M1's sprint question is testing.
        dispatch_threshold: 2,
        // 3 seconds. A lone caller on a quiet floor still gets
        // served — batching creates the queue, it shouldn't strand
        // anyone.
        dispatch_max_wait_ticks: 90,
        // 2 seconds added to a stairs estimate at capacity — enough
        // to make crew prefer a second shaft once one exists, without
        // making one occupied staircase look catastrophic.
        queue_penalty_ticks: 60,
        // 1.5 seconds, a rough midpoint between "the car is right
        // here" and "the car is at the far end of its run" — the
        // estimate crew use before the car's actual position
        // sharpens it.
        elevator_base_wait_ticks: 45,
    ),
    siege: SiegeBalance(
        // Two thirds of a second at 1x, and still a sixth of one at 4x
        // — enough frames that a kill is something you see rather than
        // something you infer from the counter going up.
        enemy_fade_ticks: 20,
        // A floor's outer skin. Cheap enough that losing one to an
        // unanswered wave is a scrape: repairing it from nothing costs
        // 30 poles and 600 ticks of crew time (see repair fields
        // below), on the order of one floor's own build cost.
        panel_hp: 150,
        // Not quite twice a panel's health — rooms sit behind the
        // skin, so it should take real work to reach one once its
        // floor's panel is already down.
        room_hp: 260,
        // Four times a panel's health. Severing a shaft is the
        // signature emergency (SYSTEMS.md §2.3) and must never be one
        // bite: a lone root-borer chewing uninterrupted (18 damage
        // every 70 ticks, see enemies/root_borer.ron) needs about
        // 2,333 ticks — roughly 78 seconds — to take a shaft from full
        // health to severed.
        shaft_hp: 600,
        // Well over six times a shaft column's health. The Heartseed
        // is the loss condition; nothing should reach it by accident,
        // and nothing should finish it quickly once something does.
        heartseed_hp: 4000,
        // The tower strides 0.6 paces/tick (world.stride_paces_per_100_ticks
        // above). 540 paces / 0.6 = 900 ticks = 30 s at 1x, comfortably
        // inside a 20-40 s reaction window between the wave-arrival
        // sound cue and contact. A creature's own approach speed
        // (EnemyDef.speed_paces_per_100_ticks) closes a little more of
        // the gap on top of the tower's own stride, which is why the
        // fast night prowler reaches contact sooner than the slow
        // root-borer despite spawning at the same distance.
        spawn_paces_ahead: 540,
        // Three a day-cycle (ticks_per_day 14400 / 4800), 160 seconds
        // apart at 1x.
        //
        // Six a day was too many to be punctuation. An opening-strength
        // wave does about 192 damage, which costs 19 poles to mend; one
        // mill makes about 20 poles in 2,400 ticks at its nominal rate
        // and rather fewer once haul latency is counted. So at the old
        // interval a tower's entire pole income went on its own skin,
        // it could never build anything again, and a damaged mill
        // turned that into a spiral it could not climb out of — which
        // is what a recorded run actually did: 0 poles in the bank
        // against a 120-pole repair bill. At 4,800 the same tower
        // spends about a quarter of its income staying whole and keeps
        // the rest.
        wave_interval_ticks: 4800,
        // Every 100 points of provocation buys 40 more threat budget.
        // At provocation_max (1000) that is +400 on top of
        // base_threat — a wave more than twenty times richer than the
        // opening one. This is the "aggressive harvester in real
        // trouble" case BALANCE.md reasons about.
        threat_per_100_provocation: 40,
        // The floor under a wave, once one is coming at all: 10 threat
        // buys two skitters (5 each — see enemies/skitter.ron). A wave
        // is never a single creature, but a barely-provoked tower gets
        // a pair rather than a pack, and the ramp to four and beyond is
        // something the player earns by playing loudly.
        //
        // This used to be 20 and unconditional, which meant the very
        // first point of provocation bought a full four-skitter wave.
        // Waves are now gated on the provocation-scaled budget being
        // able to afford something on its own, and this is only the
        // floor under that.
        base_threat: 10,
        // The ceiling every provocation-scaled field below is a
        // fraction of. Round, so "a third" (canopy leaper) and "half"
        // (root-borer) land on clean gate values.
        provocation_max: 1000,
        // Three points an item, calibrated against the decay below so
        // that one cutter arm breaks even and the second one is what
        // provokes.
        //
        // The first calibration here assumed an arm's nominal rate (one
        // stalk per 90 ticks, ~158 a day) and set gain and decay to
        // roughly cancel at that figure. Measured, a starting tower
        // strips about 101 a day, because throughput is bounded by
        // shelf space and crew legs rather than by the arm — and once
        // the storerooms fill it stops entirely. Against a decay tuned
        // for the nominal rate the dial could never turn: a two-arm
        // tower peaked at 14 points and bled back to zero the moment
        // it jammed.
        //
        // At three points an item a flowing two-arm tower nets about
        // +318 a day and draws its first wave inside the first two
        // minutes; one arm nets about +15, which is noise. Expansion
        // draws attention; subsistence does not.
        provocation_per_100_harvested: 300,
        // The burner run through one full night stretch (~4,750 ticks
        // below night_light_threshold, see the Clock section above, /
        // 100 ticks per burn = ~47 burns) raises provocation by
        // 47 x 18 = ~846 points that night alone — three times the
        // 288 a day decay sheds. Burning through the night is the
        // loudest thing a tower can do, and it should cost more than a
        // day of walking quietly can pay back.
        provocation_per_burn: 18,
        // The same three points a unit that cutting costs
        // (provocation_per_100_harvested, above). The wardens a ruin
        // rouses are the price of that ruin; charging a much louder
        // second price in provocation on top would make salvage a thing
        // nobody does twice.
        provocation_per_100_salvaged: 300,
        // 14,400 ticks / 100 x 2 = 288 points a day, a little under a
        // third of the ceiling. Set so that a subsistence tower — one
        // cutter arm, no burner — hovers at zero, and so that a tower
        // which stops provoking and just walks is back to quiet inside
        // four days however loud it had been. Everything above is a
        // multiple of this number; change it and the whole dial moves.
        provocation_decay_per_100_ticks: 2,
        // Four ticks a hit point — about a seventh of a second.
        // Fully repairing a severed shaft (600 hp) costs 2,400 ticks,
        // 80 seconds of one crew member's dedicated time: real
        // competition against hauling, not a rounding error.
        repair_ticks_per_hp: 4,
        // One pole per ten hit points: re-skinning a breached panel
        // (150 hp) costs 15 poles and rebuilding a severed shaft
        // (600 hp) costs 60.
        //
        // Repair is dearer per unit than building fresh — a floor
        // costs 6 poles all in (see the Tower section above) — because
        // it is fiddly work on something already standing. But only
        // about twice as dear. At the original 2 a panel cost 30, five
        // times a whole floor, and a tower visited at the usual rate
        // spent every pole one mill could make on putting its own skin
        // back and could never build anything again. Halving it puts
        // an undefended tower at roughly break-even: it can survive
        // indefinitely by patching, but it will not grow until it
        // answers the jungle some other way.
        repair_poles_per_10_hp: 1,
        // Twenty hit points a shift, so a shift is 80 ticks of crew
        // time and 4 poles. Chunky on purpose: a crew member who
        // commits to a repair is away from hauling for a noticeable
        // stretch, which is what makes triage a decision. Per-tick
        // repair would let them dip in and out for free.
        repair_hp_per_shift: 20,
        // A quarter health. A room keeps limping along above this —
        // damaged, slower, but still contributing (SYSTEMS.md §2.3) —
        // and only goes fully silent once it crosses this line, so the
        // player sees a visible decline before the room stops rather
        // than a surprise cliff.
        wrecked_permille: 250,
    ),
    // The handful of journey-wide constants that belong to no single
    // room and no single creature. See SYSTEMS.md §3.3-§3.5.
    journey: JourneyBalance(
        // A third of a fork interval (15,000, see
        // regions/deep_jungle.ron). A fork this close to a region edge
        // or to the region's enclave is skipped, so a decision never
        // lands on top of a boundary or a berth and competes with it
        // for the same stretch of horizon. Sized to keep region 2's
        // first fork (15,000 in) clear of the enclave (8,000 in) while
        // still dropping the second one on a short length roll — which
        // is how the rolled length turns into "how many decisions does
        // this region ask".
        fork_edge_margin_paces: 5000,
        // About a five-second window at 1x, under two at 4x — the tower
        // covers 80 paces in 133 ticks. If that reads as fiddly in
        // play, the answer is a larger number, not an approach-and-dock
        // mechanic.
        enclave_berth_paces: 80,
        // A 25-unit ruin rouses one warden (25 x 120 / 100 = 30, one
        // warden's threat exactly); a 50-unit ruin rouses two. The
        // payout and the price are the same number, which is what makes
        // "is this ruin worth it" a question about the tower rather
        // than about the ruin.
        warden_threat_per_100_salvage: 120,
        // About twenty seconds between the ground moving and the first
        // bite, at a warden's own 20 paces per 100 ticks — the same
        // order of warning spawn_paces_ahead gives an ordinary wave,
        // bought at a much shorter distance because a warden is slow.
        warden_wake_paces: 120,
    ),
)
